<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>PPV MIRROR</title>
<style>
  * { box-sizing:border-box; margin:0; padding:0; font-family:Arial, sans-serif; -webkit-tap-highlight-color:transparent; }
  :focus { outline:3px solid #60a5fa; outline-offset:2px; }
  html, body { background:#121212; color:#fff; min-height:100vh; overflow-x:hidden; font-size:16px; }
  body { padding:0.75rem; padding-bottom:2rem; }

  /* Status Bar – Hidden */
  .status-bar { display:none; }

  /* ✅ Main Header – PPV MIRROR Centered */
  .site-header { text-align:center; padding:.8rem 1rem 1rem; margin-bottom:.5rem; }
  .site-title { font-size:1.4rem; font-weight:bold; color:#fff; letter-spacing:.5px; }

  /* Collapsible Categories */
  .category { margin:1rem 0; border:1px solid #2d2d2d; border-radius:10px; overflow:hidden; }
  .cat-header { background:#1f1f1f; padding:.9rem 1rem; font-weight:bold; font-size:1rem; display:flex; justify-content:space-between; align-items:center; cursor:pointer; user-select:none; }
  .cat-toggle { font-size:.85rem; color:#94a3b8; transition:transform .2s; }
  .cat-header.collapsed .cat-toggle { transform:rotate(-90deg); }
  .live-badge { color:#ef4444; font-size:.75rem; background:rgba(239,68,68,.15); padding:.15rem .5rem; border-radius:1rem; margin-left:.5rem; white-space:nowrap; }
  .cat-body { transition:max-height .35s ease; overflow:hidden; max-height:5000px; }
  .cat-header.collapsed + .cat-body { max-height:0; }

  /* Mobile‑Optimized Grid */
  .streams-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(160px,1fr)); gap:.8rem; padding:.8rem; }
  .stream-card { background:#1e1e1e; border-radius:8px; overflow:hidden; cursor:pointer; transition:transform .15s ease, background .2s; }
  .stream-card:active { transform:scale(.97); }
  .stream-card:focus { transform:scale(1.02); background:#27272a; }

  .poster-wrap { aspect-ratio:16/9; background:#2a2a2a; overflow:hidden; position:relative; }
  .poster-wrap img { width:100%; height:100%; object-fit:cover; display:block; }
  .poster-wrap .no-poster { display:flex; align-items:center; justify-content:center; height:100%; color:#777; font-size:1.5rem; }

  .card-body { padding:.7rem; }
  .stream-name { font-weight:600; font-size:.85rem; line-height:1.25; margin-bottom:.3rem; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
  .stream-meta { font-size:.72rem; color:#9ca3af; display:flex; flex-direction:column; gap:.2rem; line-height:1.3; }
  .tag { display:inline-block; background:#3b82f6; color:#fff; padding:.1rem .4rem; border-radius:4px; font-size:.65rem; margin-right:.3rem; }
  .countdown { color:#facc15; }
  .status-scheduled { color:#60a5fa; }
  .status-live { color:#22c55e; }
  .status-ended { color:#f87171; }

  /* Full‑Screen Player Modal */
  .modal { position:fixed; inset:0; width:100vw; height:100vh; background:#000; display:none; flex-direction:column; z-index:9999; padding:0; margin:0; }
  .modal.active { display:flex; }
  .modal-header { display:flex; justify-content:space-between; align-items:center; padding:.7rem 1rem; background:#121212; border-bottom:1px solid #333; font-size:.95rem; min-height:52px; flex-shrink:0; }
  .modal-title { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:calc(100% - 80px); }
  .close-btn { background:#27272a; border:none; color:#fff; padding:.5rem 1rem; border-radius:6px; cursor:pointer; font-size:.9rem; white-space:nowrap; }
  .close-btn:hover, .close-btn:active { background:#ef4444; }

  .player-container { flex:1; width:100%; height:calc(100vh - 52px); position:relative; overflow:hidden; background:#000; }
  .player-container iframe {
    position:absolute;
    top:0; left:0;
    width:100%; height:100%;
    border:none; display:block;
    background:#000;
  }
  .no-player { text-align:center; color:#9ca3af; padding:3rem 1.5rem; }

  /* Desktop/Tablet */
  @media (min-width:768px) {
    body { padding:1.5rem; max-width:1400px; margin:0 auto; }
    .site-title { font-size:1.8rem; }
    .streams-grid { grid-template-columns:repeat(auto-fill, minmax(240px,1fr)); gap:1rem; padding:1rem; }
    .cat-header { font-size:1.15rem; padding:1rem 1.3rem; }
    .stream-name { font-size:.95rem; }
    .stream-meta { font-size:.8rem; }
  }
</style>
</head>
<body>

<!-- ✅ New: Centered Title -->
<div class="site-header">
  <h1 class="site-title">PPV MIRROR</h1>
</div>

<div class="status-bar" id="status"></div>
<div id="app"></div>

<!-- Full‑Screen Player Modal -->
<div class="modal" id="playerModal">
  <div class="modal-header">
    <span class="modal-title" id="modalTitle">Stream Player</span>
    <button class="close-btn" onclick="closePlayer()">✕ Close</button>
  </div>
  <div class="player-container" id="playerContainer"></div>
</div>

<script>
let baseDomains = ["https://api.ppv.st"];
let activeDomain = baseDomains[0];
let refreshTimer = null;

// --- Ping & Domain Failover ---
async function pingDomains(){
  for(const domain of baseDomains){
    try{
      const res = await fetch(`${domain}/api/ping`, {cache:'no-store'});
      const data = await res.json();
      if(data.success && data.domains?.length){
        baseDomains = data.domains.map(d=> d.startsWith('http') ? d : `https://${d}`);
        if(!baseDomains.includes(domain)) baseDomains.unshift(domain);
        activeDomain = domain;
        return true;
      }
    }catch(e){ continue; }
  }
  return false;
}

// --- Fetch Streams ---
async function fetchStreams(){
  const ok = await pingDomains();
  if(!ok) return;
  try {
    const res = await fetch(`${activeDomain}/api/streams`, {cache:'no-store'});
    const data = await res.json();
    if(!data.success) throw new Error('API Error');
    renderStreams(data.streams);
    console.info('ℹ️', data.READ_ME, `Updated: ${new Date(data.timestamp*1000).toLocaleString()} | Perf: ${data.performance}s`);
  }catch(err){
    console.error(`Load failed: ${err.message}`);
  }
}

// --- Status & Countdown ---
function getStreamInfo(stream){
  const now = Math.floor(Date.now()/1000);
  const {starts_at, ends_at, always_live} = stream;
  if(always_live === 1) return {text:'🔴 ALWAYS LIVE', class:'status-live', countdown:''};
  if(now < starts_at){
    let sec = starts_at - now;
    let h = Math.floor(sec/3600), m = Math.floor((sec%3600)/60), s = sec%60;
    let cd = h>0 ? `${h}h ${m}m ${s}s` : `${m}m ${s}s`;
    return {text:'⏰ Scheduled', class:'status-scheduled', countdown:`Starts in: ${cd}`};
  }
  if(now >= starts_at && now < ends_at) return {text:'🔴 LIVE NOW', class:'status-live', countdown:''};
  return {text:'⏹ Ended', class:'status-ended', countdown:''};
}

// --- Render Collapsible Categories ---
function renderStreams(categories){
  const app = document.getElementById('app');
  app.innerHTML='';

  categories.forEach(cat=>{
    const catEl = document.createElement('div');
    catEl.className='category';
    catEl.innerHTML = `
      <div class="cat-header" tabindex="0">
        <span style="display:flex;align-items:center;gap:.4rem;">
          <span class="cat-toggle">▼</span>
          ${cat.category}
          ${cat.always_live ? `<span class="live-badge">LIVE</span>` : ''}
        </span>
      </div>
      <div class="cat-body"><div class="streams-grid"></div></div>
    `;

    const header = catEl.querySelector('.cat-header');
    header.addEventListener('click', ()=> header.classList.toggle('collapsed'));
    header.addEventListener('keydown', e=> {
      if(e.key==='Enter' || e.key===' ') { e.preventDefault(); header.classList.toggle('collapsed'); }
    });

    const grid = catEl.querySelector('.streams-grid');
    cat.streams.forEach(stream=>{
      const info = getStreamInfo(stream);
      const card = document.createElement('div');
      card.className='stream-card';
      card.tabIndex=0;

      card.innerHTML = `
        <div class="poster-wrap">
          ${stream.poster ? `<img src="${stream.poster}" alt="${stream.name}" loading="lazy">` : `<div class="no-poster">🎬</div>`}
        </div>
        <div class="card-body">
          <div class="stream-name">${stream.name}</div>
          <div class="stream-meta">
            <div>${stream.tag ? `<span class="tag">${stream.tag}</span>` : ''}<span class="${info.class}">${info.text}</span></div>
            ${info.countdown ? `<div class="countdown">${info.countdown}</div>` : ''}
            ${stream.allowpaststreams===1 ? `<div>📜 Replay OK</div>` : ''}
          </div>
        </div>
      `;

      card.addEventListener('click', ()=> openStream(stream));
      card.addEventListener('keydown', e=> e.key==='Enter' && openStream(stream));
      grid.appendChild(card);
    });

    app.appendChild(catEl);
  });
}

// --- Build working iframe from URL or full HTML ---
function buildIframe(src){
  if(!src) return null;
  if(src.trim().startsWith('<iframe')) return src;
  if(src.startsWith('http')){
    return `<iframe src="${src}" allowfullscreen allow="autoplay; fullscreen; picture-in-picture; encrypted-media"></iframe>`;
  }
  return null;
}

// --- Open Stream & Load Perfect Fit Player ---
function openStream(stream){
  const modal = document.getElementById('playerModal');
  const container = document.getElementById('playerContainer');
  document.getElementById('modalTitle').textContent = stream.name;

  let iframeCode = null;
  if(stream.iframe && stream.iframe.trim()){
    iframeCode = buildIframe(stream.iframe.trim());
  }

  if(iframeCode){
    container.innerHTML = iframeCode;
    const iframe = container.querySelector('iframe');
    if(iframe){
      iframe.style.cssText = 'position:absolute;top:0;left:0;width:100%;height:100%;border:none;display:block;';
      iframe.setAttribute('allowfullscreen','');
      if(!iframe.hasAttribute('allow')) iframe.setAttribute('allow','autoplay; fullscreen; picture-in-picture; encrypted-media');
    }
  } else {
    container.innerHTML = `
      <div class="no-player">
        <h3>⚠️ No Embed Found</h3>
        <p><strong>${stream.name}</strong></p>
        <p style="margin-top:.5rem; font-size:.8rem; color:#aaa;">No embed URL or iframe provided for this stream</p>
      </div>
    `;
  }

  modal.classList.add('active');
  document.body.style.overflow = 'hidden';
}

function closePlayer(){
  document.getElementById('playerModal').classList.remove('active');
  document.getElementById('playerContainer').innerHTML='';
  document.body.style.overflow = '';
}

function updateStatus(txt){}

// --- TV / Remote Navigation ---
document.addEventListener('keydown', e=>{
  if(document.getElementById('playerModal').classList.contains('active')){
    if(e.key==='Escape') closePlayer();
    return;
  }
  const items = Array.from(document.querySelectorAll('.stream-card, .cat-header'));
  if(!items.length) return;
  let idx = items.indexOf(document.activeElement);
  if(idx === -1 && ['ArrowDown','ArrowUp','ArrowRight','ArrowLeft'].includes(e.key)){
    items[0]?.focus();
    return;
  }
  const cols = Math.max(1, Math.round((document.querySelector('.streams-grid')?.clientWidth || 320)/170));
  if(e.key==='ArrowDown' && idx+cols < items.length) items[idx+cols].focus();
  if(e.key==='ArrowUp' && idx-cols >=0) items[idx-cols].focus();
  if(e.key==='ArrowRight' && idx+1 < items.length) items[idx+1].focus();
  if(e.key==='ArrowLeft' && idx>0) items[idx-1].focus();
});

// --- Auto‑Refresh every 60s ---
function startAutoRefresh(){ if(refreshTimer) clearInterval(refreshTimer); refreshTimer = setInterval(fetchStreams, 60000); }

fetchStreams();
startAutoRefresh();
</script>
</body>
</html>
